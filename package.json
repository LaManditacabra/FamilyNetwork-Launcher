{
  "name": "family-launcher",
  "version": "0.1.7",
  "description": "Launcher de Minecraft de escritorio multiplataforma",
  "main": "src/main/index.js",
  "author": "Family Launcher Team",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "test": "node --test",
    "pack": "electron-builder --dir",
    "build:win": "electron-builder --win",
    "build:linux": "electron-builder --linux",
    "build:mac": "electron-builder --mac"
  },
  "devDependencies": {
    "electron": "^30.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.familylauncher.app",
    "productName": "Family Launcher",
    "directories": {
      "output": "dist",
      "buildResources": "assets"
    },
    "files": [
      "src/**/*",
      "config/**/*",
      "package.json"
    ],
    "win": {
      "target": ["nsis", "portable"],
      "icon": "assets/icons/icon.ico"
    },
    "linux": {
      "target": ["AppImage", "deb"],
      "icon": "assets/icons/icon.png",
      "category": "Game"
    },
    "mac": {
      "target": ["dmg"],
      "icon": "assets/icons/icon.png",
      "category": "public.app-category.games"
    }
  }
}
